@{
    var disciplinas = (ViewBag.Disciplinas as List<string>)!;
    var notas = (ViewBag.Notas as List<double>)!;
}

<h2>Boletim</h2>

<table border="1">
    <tr>
        <th>Disciplina</th>
        <th>Nota</th>
        <th>Status</th>
        <th>Conceito</th>
    </tr>

    @for (int i = 0; i < disciplinas.Count; i++)
    {
        var nota = notas[i];

        <tr>
            <td>@disciplinas[i]</td>
            <td>@nota</td>

            <td>
                @if (nota >= 6)
                {
                    <span style="color:green">Aprovado</span>
                }
                else
                {
                    <span style="color:red">Reprovado</span>
                }
            </td>

            <td>
                @{
                    string conceito;
                    if (nota >= 9)      conceito = "A";
                    else if (nota >= 7) conceito = "B";
                    else if (nota >= 5) conceito = "C";
                    else                conceito = "D";
                }
                <span>@conceito</span>
            </td>
        </tr>
    }

    <tr>
        <td><b>Média Geral</b></td>
        <td colspan="3"><b>@notas.Average().ToString("F2")</b></td>
    </tr>
</table>